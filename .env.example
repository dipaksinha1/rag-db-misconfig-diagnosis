# Copy to .env and fill in the secrets. .env is gitignored; never commit it.
# Everything except the API key and ANTHROPIC_MODEL has a working default,
# and the defaults here are the same ones compose.yaml and pgdiag.config use.

# --- Diagnosis LLM (needed from T9 on) ---------------------------------------
# Set ONE key. OPENROUTER_API_KEY wins when both are set (calls go to openrouter.ai).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Model name in the provider's format. OpenRouter: anthropic/claude-opus-5.5;
# Anthropic API directly: claude-opus-5-5. Same format for PGDIAG_JUDGE_MODEL.
ANTHROPIC_MODEL=anthropic/claude-opus-5.5
# Model that grades the reasoning (pgdiag-evaluate --judge). Empty = ANTHROPIC_MODEL.
# A different model avoids a model grading its own answers.
PGDIAG_JUDGE_MODEL=

# --- Test database (PostgreSQL 16 in Docker; read by compose.yaml and pgdiag) --
PGDIAG_DB_HOST=localhost
# Host port; 5433 avoids clashing with a local PostgreSQL on 5432.
PGDIAG_DB_PORT=5433
PGDIAG_DB_NAME=pgdiag
PGDIAG_DB_USER=pgdiag
PGDIAG_DB_PASSWORD=pgdiag
# Container memory limit (includes the page cache). The generated data (~700 MB)
# must be clearly larger than this.
PGDIAG_DB_MEM_LIMIT=256m
# /dev/shm size, used by parallel queries.
PGDIAG_DB_SHM_SIZE=128m

# --- RAG index ---------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Crawling postgresql.org -------------------------------------------------
# Seconds between requests. Values below 1.0 are raised to 1.0.
CRAWL_DELAY_SECONDS=1.0
# Optional contact (e.g. an email address) appended to the crawler's User-Agent.
CRAWLER_CONTACT=
# Unused: the mailing-list stage (T3) was skipped because robots.txt disallows the
# archive listings (see PROGRESS.md). Meant as: pgsql-performance threads from this
# year through the end year (empty = current year).
MAILING_LIST_START_YEAR=2015
MAILING_LIST_END_YEAR=
